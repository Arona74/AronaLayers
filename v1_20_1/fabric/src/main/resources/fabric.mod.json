{
	"schemaVersion": 1,
	"id": "aronalayers",
	"version": "${version}",
	"name": "AronaLayers: Blocks",
	"description": "Layer blocks (stackable two pixel tall blocks) and 3D layers for most vanilla blocks. Based on Vanilla+ Layers by Fellter.",
	"authors": [
		"Arona74"
	],
	"contributors": [
		"Fellter (original Vanilla+ Layers)"
	],
	"contact": {
		"sources": "https://github.com/Arona74/AronaLayers",
		"issues": "https://github.com/Arona74/AronaLayers/issues"
	},
	"license": "CC-BY-NC-4.0",
	"icon": "assets/aronalayers/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.arona74.aronalayers.fabric.AronaLayersFabric"
		],
		"fabric-datagen": [
			"io.arona74.aronalayers.AronaLayersDataGenerator"
		],
		"client": [
			"io.arona74.aronalayers.fabric.AronaLayersFabricClient"
		],
		"modmenu": [
			"io.arona74.aronalayers.gen.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"aronalayers.mixins.json",
		"aronalayers.tools.mixins.json",
		"aronalayers.gen.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.11",
		"minecraft": "1.20.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"breaks": {
		"aronalayersgen": "*",
		"aronalayersextras": "*"
	}
}

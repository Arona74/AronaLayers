{
	"schemaVersion": 1,
	"id": "aronalayers",
	"version": "${version}",
	"name": "AronaLayers",
	"description": "Layer blocks (stackable two pixel tall blocks) and 3D layers for most vanilla blocks, terrain generation that smooths slopes with layers, and vanilla mechanics for layers (grass spreading, sheep, falling with sand, small ores). Based on Vanilla+ Layers by Fellter.",
	"authors": [
		"Arona74"
	],
	"contributors": [
		"Fellter (original Vanilla+ Layers)"
	],
	"contact": {
		"homepage": "https://github.com/Arona74/AronaLayers",
		"sources": "https://github.com/Arona74/AronaLayers",
		"issues": "https://github.com/Arona74/AronaLayers/issues"
	},
	"license": "CC-BY-NC-4.0 AND MIT",
	"icon": "assets/aronalayers/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.arona74.aronalayers.fabric.AronaLayersFabric"
		],
		"fabric-datagen": [
			"io.arona74.aronalayers.AronaLayersDataGenerator"
		],
		"client": [
			"io.arona74.aronalayers.fabric.AronaLayersFabricClient"
		],
		"modmenu": [
			"io.arona74.aronalayers.gen.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"aronalayers.mixins.json",
		"aronalayers.tools.mixins.json",
		"aronalayers.gen.mixins.json",
		"aronalayers.gameplay.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.5",
		"minecraft": "1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"breaks": {
		"aronalayersgen": "*",
		"aronalayersextras": "*"
	}
}
